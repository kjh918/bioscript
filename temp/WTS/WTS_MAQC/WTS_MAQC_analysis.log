----- BAM QC (manual run) -----
>>>
    RUN_SINGULARITY="singularity exec -B /storage,/data /storage/images"
    MULTIQC_CONFIG=/storage/home/kangsm/runScripts/NGS_config.MultiQC_Custom.yaml
    BASE_DIR="/data/wts"
    SEQ_FOLDER="WTS_MAQC"

    for SEQ_ID in MAQC_A_rep1 MAQC_A_rep2 MAQC_B_rep1 MAQC_B_rep2 MAQC_C_F1_rep1 MAQC_C_F1_rep2 MAQC_C_F2_rep1 MAQC_C_F2_rep2
    do
        QC_DIR=${BASE_DIR}/${SEQ_FOLDER}/${SEQ_ID}/qcfiles
        ${RUN_SINGULARITY}/multiqc-1.18.sif multiqc --force \
            --filename ${SEQ_ID}_qc \
            --outdir ${BASE_DIR}/${SEQ_FOLDER}/${SEQ_ID}/qcfiles/qc_res \
            --config ${MULTIQC_CONFIG} \
            --data-dir ${BASE_DIR}/${SEQ_FOLDER}/${SEQ_ID}/qcfiles

        Rscript /storage/home/kangsm/runScripts/WTS_run.Multiqc_PostProcessing.R \
            --BASE_DIR ${BASE_DIR} \
            --SEQ_FOLDER ${SEQ_FOLDER} \
            --SEQ_ID ${SEQ_ID} \
            --DB_IMPORT TRUE
    done

    for SEQ_ID in MAQC_A_rep1 MAQC_A_rep2 MAQC_B_rep1 MAQC_B_rep2 MAQC_C_F1_rep1 MAQC_C_F1_rep2 MAQC_C_F2_rep1 MAQC_C_F2_rep2
    do
        Rscript /storage/home/kangsm/runScripts/WTS_run.CreateExprValuesObjects.R \
            --BASE_DIR ${BASE_DIR} \
            --SEQ_FOLDER ${SEQ_FOLDER} \
            --SEQ_ID ${SEQ_ID} \
            --DB_IMPORT TRUE
    done


