BASE_DIR="/storage/home/kangsm/analysis/cnv_seqc2"
SEQ_FOLDER="hg38"
DATA_DIR = sprintf("%s/%s", BASE_DIR, SEQ_FOLDER)
RUN_DIR = sprintf("%s/%s/cnv/superfreq", DATA_DIR, TUMOR_SEQ_ID)

PLOIDY_DATA_DIR = sprintf("%s/%s/%s/data", RUN_DIR, SET_ID, SET_ID)
#--------------------------------------------------------------------------#
SuperFreqRes <- data.frame(NAME=c(TUMOR_SEQ_ID,NORMAL_SEQ_ID), PLOIDY=NA, PLOIDY_INT=NA)
for( n in 1:nrow(SuperFreqRes) )
{
    SegRes <- read.delim(sprintf("%s/CNAsegments_%s.tsv", PLOIDY_DATA_DIR, SuperFreqRes[n,"NAME"]))
    ploidy <- Calculate.superFreq.Ploidy( SegRes )
    SuperFreqRes[n, "PLOIDY"]     = round(ploidy, 3)
    SuperFreqRes[n, "PLOIDY_INT"] = round(ploidy + 0.1, 0)
}
#--------------------------------------------------------------------------#
load(sprintf("%s/%s/fit.Rdata", RUN_DIR, SET_ID)) # fit
sex_res          <- fit$fit$sex
names(sex_res)   <- gsub("\\-normal", "", names(sex_res))
SuperFreqRes$SEX <- sex_res[ SuperFreqRes$NAME ]
#--------------------------------------------------------------------------#
load(sprintf("%s/%s/stories.Rdata", RUN_DIR, SET_ID)) # stories
PR                  <- stories$stories[[SET_ID]]$clusters$cloneStories %>% filter( call != "germline" ) 
purity              <- apply(PR$stories, 2, function(y) max(y))
SuperFreqRes$PURITY <- round(purity[ SuperFreqRes$NAME ], 4)
#--------------------------------------------------------------------------#
SuperFreqRes$LOGRATIO_SHIFT <- sapply( SuperFreqRes$PLOIDY_INT, function(PI)
{
    if( PI >= 3 ){ LS = -0.4 }else{ LS = 0 }
    return(LS)
})
#--------------------------------------------------------------------------#
write.table(SuperFreqRes, sprintf("%s/%s_ploidy_sex_purity.txt", RUN_DIR, SET_ID), quote=F, col.names=F, row.names=F, sep=" ")
write.table(SuperFreqRes, sprintf("%s/%s_ploidy_sex_purity.tsv", RUN_DIR, SET_ID), quote=F, col.names=T, row.names=F, sep="\t")


