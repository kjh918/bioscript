### 2024-04-16 : CRC5 ASCAT

BASE_DIR=/storage/home/kangsm/analysis
SEQ_FOLDER="crc.nto.5samples"
INPUT_LIST_FILE=${BASE_DIR}/${SEQ_FOLDER}/meta/NT_matching.list
THREADS=20
GENOME_ASSEMBLY="hg19"
RUN_SCRIPT=/storage/home/kangsm/runScripts
BED_PREFIX=/storage/references_and_index/hg19/bed/Agilent_SureSelect_v6/GRCh37_sureselect.v6
SEQ_DEPTH=200

for SGE_TASK_ID in $(seq 1 10)
do
    SEQ_INFO=$(sed -n -e "${SGE_TASK_ID} p" ${INPUT_LIST_FILE})
    TUMOR_SEQ_ID=$(echo ${SEQ_INFO} | awk '{print $2}')
    NORMAL_SEQ_ID=$(echo ${SEQ_INFO} | awk '{print $1}')

    Rscript /storage/home/kangsm/runScripts/WES_run.CNV_ASCAT.R \
        --baseDir ${BASE_DIR} \
        --seqFolder ${SEQ_FOLDER} \
        --tumorSeqID ${TUMOR_SEQ_ID} \
        --normalSeqID ${NORMAL_SEQ_ID} \
        --bed ${BED_PREFIX}.target.bed \
        --assembly ${GENOME_ASSEMBLY} \
        --threads ${THREADS}
done


BASE_DIR=/storage/home/kangsm/analysis/cnv_seqc2
SEQ_FOLDER=hg38
N_TYPE=TS_N

    TUMOR_SEQ_ID=FD1_T
    NORMAL_SEQ_ID=NV1_N

    CNV_RES_DIR=${BASE_DIR}/${SEQ_FOLDER}/${TUMOR_SEQ_ID}/cnv
    CNVKIT_RES_DIR=${CNV_RES_DIR}/cnvkit

    SUPERFREQ_RES_FILE=${BASE_DIR}/${SEQ_FOLDER}/${TUMOR_SEQ_ID}/cnv/superfreq/${TUMOR_SEQ_ID}.Tonly_ploidy_sex_purity.txt
    SUPERFREQ_DATA=$(cat ${SUPERFREQ_RES_FILE})
    SEX=$(echo $SUPERFREQ_DATA | awk '{print $4}')

    CNVKIT_VCF=${BASE_DIR}/${SEQ_FOLDER}/${TUMOR_SEQ_ID}/vcf/${TUMOR_SEQ_ID}.mutect2.NT.cnvkit.vcf

    ASCAT_DIR=${BASE_DIR}/${SEQ_FOLDER}/${TUMOR_SEQ_ID}/cnv/ascat
    ln -s ${ASCAT_DIR}/${TUMOR_SEQ_ID}.ASCAT.purity.sex.ploidy.txt ${ASCAT_DIR}/${TUMOR_SEQ_ID}.TS_N.ASCAT.purity.sex.ploidy.txt
    ASCAT_DATA=$(cat ${ASCAT_DIR}/${TUMOR_SEQ_ID}.TS_N.ASCAT.purity.sex.ploidy.txt)
    PURITY=$(echo $ASCAT_DATA | awk '{print $2}')
    PLOIDY=$(echo $ASCAT_DATA | awk '{print $4}')
    PLOIDY_INT=$(echo $ASCAT_DATA | awk '{print $5}')

    ${RUN_CNVKIT} call \
        --output ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.ASCAT.call.cns \
        --sample-id ${TUMOR_SEQ_ID} \
        --normal-id ${NORMAL_SEQ_ID} \
        --vcf ${CNVKIT_VCF} \
        --purity ${PURITY} \
        --sample-sex ${SEX} \
        ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.cns

    echo -e "ID\tPLOIDY\tPLOIDY_INT\tPURITY\tSEX" > ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.call.ASCAT.params
    echo -e "${TUMOR_SEQ_ID}\t${PLOIDY}\t${PLOIDY_INT}\t${PURITY}\t${SEX}" >>${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.call.ASCAT.params

    PURECN_NT=${BASE_DIR}/${SEQ_FOLDER}/${TUMOR_SEQ_ID}/cnv/purecn/TumorOnly_mode/${TUMOR_SEQ_ID}.csv
    cat ${PURECN_NT}

    PLOIDY=2
    PLOIDY_INT=2
    PURITY=0.33

    ${RUN_CNVKIT} call \
        --output ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.PureCN.Tonly.call.cns \
        --sample-id ${TUMOR_SEQ_ID} \
        --normal-id ${NORMAL_SEQ_ID} \
        --vcf ${CNVKIT_VCF} \
        --purity ${PURITY} \
        --sample-sex ${SEX} \
        ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.cns

    echo -e "ID\tPLOIDY\tPLOIDY_INT\tPURITY\tSEX" > ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.call.PureCN.Tonly.params
    echo -e "${TUMOR_SEQ_ID}\t${PLOIDY}\t${PLOIDY_INT}\t${PURITY}\t${SEX}" >>${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.call.PureCN.Tonly.params



    ASCAT_DIR=${BASE_DIR}/${SEQ_FOLDER}/${TUMOR_SEQ_ID}/cnv/ascat
    ln -s ${ASCAT_DIR}/${TUMOR_SEQ_ID}.ASCAT.purity.sex.ploidy.txt ${ASCAT_DIR}/${TUMOR_SEQ_ID}.TS_N.ASCAT.purity.sex.ploidy.txt
    ASCAT_DATA=$(cat ${ASCAT_DIR}/${TUMOR_SEQ_ID}.TS_N.ASCAT.purity.sex.ploidy.txt)
    PURITY=$(echo $ASCAT_DATA | awk '{print $2}')
    PLOIDY_INT=$(echo $ASCAT_DATA | awk '{print $5}')

    ${RUN_CNVKIT} call \
        --output ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.ASCAT.call.cns \
        --sample-id ${TUMOR_SEQ_ID} \
        --normal-id ${NORMAL_SEQ_ID} \
        --vcf ${CNVKIT_VCF} \
        --purity ${PURITY} \
        --sample-sex ${SEX} \
        ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.cns

    echo -e "ID\tPLOIDY\tPLOIDY_INT\tPURITY\tSEX" > ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.call.ASCAT.params
    echo -e "${TUMOR_SEQ_ID}\t${PLOIDY}\t${PLOIDY_INT}\t${PURITY}\t${SEX}" >>${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.call.ASCAT.params

            ${RUN_CNVKIT} segment \
                --output ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.cns \
                --dataframe ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.cbs.txt \
                --method cbs \
                --smooth-cbs \
                --drop-low-coverage \
                --drop-outliers 4 \
                --processes ${THREADS} \
                --vcf ${CNVKIT_VCF} \
                --sample-id ${TUMOR_SEQ_ID} \
                --normal-id ${NORMAL_SEQ_ID} \
                ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.cnr


    TUMOR_SEQ_ID=NV3_T
    CNV_RES_DIR=${BASE_DIR}/${SEQ_FOLDER}/${TUMOR_SEQ_ID}/cnv
    CNVKIT_RES_DIR=${CNV_RES_DIR}/cnvkit

    cp ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.ASCAT.call.cns ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.call.cns
    cp ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.call.ASCAT.params ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.call.params
    cp ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.cnr ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.cnr
    cp ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.cns ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.cns

    ${RUN_CNVKIT} segmetrics \
        --segments ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.cns \
        --output ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.segmetrics.txt \
        --drop-low-coverage \
        --mean --median --mode --mse --ci --smooth-bootstrap \
        ${CNVKIT_RES_DIR}/${TUMOR_SEQ_ID}.NT.${N_TYPE}_N.cnr

